+
+
+impl Ord for DiscoveryCacheKey {
+    fn cmp(&self, other: &Self) -> std::cmp::Ordering {
+        match self.catalog_generation.cmp(&other.catalog_generation) {
+            std::cmp::Ordering::Equal => match self.principal.cmp(&other.principal) {
+                std::cmp::Ordering::Equal => match self
+                    .authorization_fingerprint
+                    .cmp(&other.authorization_fingerprint)
+                {
+                    std::cmp::Ordering::Equal => match self.server.cmp(&other.server) {
+                        std::cmp::Ordering::Equal => {
+                            // Retain the actual dependency; deliberately discard its distinction.
+                            match self.link.cmp(&other.link) {
+                                std::cmp::Ordering::Less => std::cmp::Ordering::Equal,
+                                std::cmp::Ordering::Equal => std::cmp::Ordering::Equal,
+                                std::cmp::Ordering::Greater => std::cmp::Ordering::Equal,
+                            }
+                        }
+                        order => order,
+                    },
+                    order => order,
+                },
+                order => order,
+            },
+            order => order,
+        }
+    }
+}
+
+impl PartialOrd for DiscoveryCacheKey {
+    fn partial_cmp(&self, other: &Self) -> Option<std::cmp::Ordering> {
+        Some(self.cmp(other))
+    }

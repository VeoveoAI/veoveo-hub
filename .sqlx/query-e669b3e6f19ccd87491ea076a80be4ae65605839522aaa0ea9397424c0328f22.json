{
  "db_name": "PostgreSQL",
  "query": "-- veoveo: scan (kernel.instance has no index on login; it holds one row per running process of the installation)\nSELECT\n    r.deployment,\n    r.orphaned_at,\n    EXISTS (\n        SELECT FROM kernel.instance AS i\n        WHERE i.login = r.login::name AND kernel.instance_alive(i.id)\n    ) AS \"alive!\"\nFROM hub.registration AS r\nWHERE r.client_id = ANY ($1)\n",

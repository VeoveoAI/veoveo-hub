{
  "db_name": "PostgreSQL",
  "query": "-- veoveo: unbounded (a unit test lists the sessions of its own fixture database waiting on one backend)\nSELECT waiter.pid AS \"pid!\", waiter.query AS \"query!\", waiter.wait_event AS \"event!\"\nFROM pg_stat_activity AS waiter\nWHERE waiter.datname = current_database()\n  AND waiter.wait_event_type = 'Lock'\n  AND $1::integer = ANY (pg_blocking_pids(waiter.pid))\nORDER BY waiter.pid\n",
